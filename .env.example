# ──────────────────────────────────────────────────────────────
# Root .env — Shared secrets for the Docker Compose stack.
# Copy to .env (gitignored) and fill in values. NEVER commit real secrets.
# `make init` copies this template to .env for local (mock) demos.
# ──────────────────────────────────────────────────────────────

# OpenAI API Key — used by the backend for chat + embeddings
OPENAI_API_KEY=sk-...

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-here

# Anthropic API Key — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# JWT access-token lifetime
JWT_EXPIRES_IN=7d

# LLM provider switcher: mock (no key) | openai | anthropic
LLM_PROVIDER=mock

# Embeddings for RAG. Auto-selects openai when OPENAI_API_KEY is set, else mock.
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=text-embedding-3-small
