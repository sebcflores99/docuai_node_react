# ──────────────────────────────────────────────────────────────
# Root .env — Shared secrets for Docker Compose stack
# Copy to .env (gitignored). NEVER commit real secrets.
#
# For local backend development (pnpm dev), copy this to backend/.env
# ──────────────────────────────────────────────────────────────

# OpenAI API Key — used by backend & Weaviate text2vec-openai
OPENAI_API_KEY=sk-...

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-here

# Anthropic API Key — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# JWT access-token lifetime
JWT_EXPIRES_IN=7d

# LLM provider switcher: mock (no key) | openai | anthropic
LLM_PROVIDER=mock

# Embeddings for RAG. Auto-selects openai when OPENAI_API_KEY is set, else mock.
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=text-embedding-3-small
