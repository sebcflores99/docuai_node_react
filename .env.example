# ──────────────────────────────────────────────────────────────
# Root .env — Shared secrets for the Docker Compose stack.
# Copy to .env (gitignored) and fill in values. NEVER commit real secrets.
# `make init` copies this template to .env for local (mock) demos.
#
# As shipped, everything runs OFFLINE with the mock providers — no API keys
# needed. To use real models, fill in a key and switch the provider(s) below.
# ──────────────────────────────────────────────────────────────

# Leave blank to run offline. Set to use real OpenAI chat and/or embeddings.
OPENAI_API_KEY=
# Set to use Anthropic chat (LLM_PROVIDER=anthropic). Anthropic has no embeddings API.
ANTHROPIC_API_KEY=

# JWT signing secret. Any non-empty value works locally; use a strong random
# value in production, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Chat model provider: mock (no key) | openai | anthropic
LLM_PROVIDER=mock

# Embeddings provider for RAG: mock (no key) | openai
# Keep this explicit so the offline default never tries to call OpenAI.
EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=text-embedding-3-small

