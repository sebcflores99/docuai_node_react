# ──────────────────────────────────────────────────────────────
# Root .env — consumed by docker-compose.yml for the FULL stack.
# Copy to .env (gitignored). NEVER commit real secrets.
#
# DATABASE_URL and WEAVIATE_URL are set directly in docker-compose.yml
# (they point at the `postgres` / `weaviate` service names), so only
# the secrets below need to live here.
#
# To run the backend WITHOUT Docker (pnpm dev), use backend/.env
# instead — see backend/.env.example.
# ──────────────────────────────────────────────────────────────

# OpenAI — also used by Weaviate's text2vec-openai module
OPENAI_API_KEY=sk-...

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-here

# LLM provider switcher (openai | anthropic)
LLM_PROVIDER=openai
