# ──────────────────────────────────────────────────────────────
# backend/.env — For running backend locally WITHOUT Docker
# (pnpm dev). Loaded via dotenv.
#
# Copy this to backend/.env and fill in values.
# Inside Docker, values come from root .env instead.
# ──────────────────────────────────────────────────────────────

PORT=8000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docuai

# Vector Store
WEAVIATE_URL=http://localhost:8080

# AI Secrets (same as root .env)
OPENAI_API_KEY=sk-...
JWT_SECRET=your-secret-here
LLM_PROVIDER=openai
