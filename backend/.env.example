# ──────────────────────────────────────────────────────────────
# backend/.env — For running backend locally WITHOUT Docker
# (pnpm dev). Loaded via dotenv.
#
# Copy this to backend/.env and fill in values.
# Inside Docker, values come from root .env instead.
# ──────────────────────────────────────────────────────────────

PORT=8000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docuai

# Vector Store
WEAVIATE_URL=http://localhost:8080

# AI Secrets (same as root .env)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=7d

# LLM provider: mock (default, no API key) | openai | anthropic
LLM_PROVIDER=mock

# Embeddings for RAG. Auto-selects openai when OPENAI_API_KEY is set, else mock.
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=text-embedding-3-small
