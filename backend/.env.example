# ──────────────────────────────────────────────────────────────
# backend/.env — for running the backend locally WITHOUT Docker
# (pnpm dev). Loaded via dotenv. Copy to backend/.env (gitignored).
#
# Inside Docker these values come from docker-compose.yml instead,
# so this file is only needed for standalone local development.
# ──────────────────────────────────────────────────────────────

PORT=8000
NODE_ENV=development

# Point at the Compose-managed services exposed on localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docuai
WEAVIATE_URL=http://localhost:8080

OPENAI_API_KEY=sk-...
JWT_SECRET=your-secret-here
LLM_PROVIDER=openai
